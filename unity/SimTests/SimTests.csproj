<Project Sdk="Microsoft.NET.Sdk">
  <!-- The sim's tests: plain C#, no Unity and no licence, so CI can run them (D-470 U2). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../Assets/Scripts/Sim/**/*.cs" />
    <Compile Include="../Assets/Scripts/GameLogic/**/*.cs" />
    <Compile Include="../Assets/Scripts/Rampage/RooftopAim.cs" />
    <Compile Include="../Assets/Scripts/Rampage/PostFxState.cs" />
    <Compile Include="../Assets/Scripts/Rampage/Pavements.cs" />
    <Compile Include="../Assets/Scripts/Rampage/BeachLayout.cs" />
    <Compile Include="../Assets/Scripts/Rampage/StreetPeople.cs" />
    <Compile Include="../Assets/Scripts/Rampage/TrafficNet.cs" />
    <Compile Include="../Assets/Scripts/Rampage/Traffic.cs" />
    <Compile Include="../Assets/Scripts/Rampage/Police.cs" />
    <Compile Include="../Assets/Scripts/Rampage/StreetOfficers.cs" />
    <Compile Include="../Assets/Scripts/Rampage/LightPool.cs" />
    <Compile Include="../Assets/Scripts/Rampage/VoxelJitter.cs" />
    <Compile Include="../Assets/Scripts/Rampage/TankKeepOut.cs" />
    <Compile Include="../Assets/Scripts/Rampage/DiagonalParking.cs" />
    <Compile Include="../Assets/Scripts/Rampage/VipPaint.cs" />
    <Compile Include="../Assets/Scripts/Rampage/AirstrikePath.cs" />
    <Compile Include="../Assets/Scripts/Rampage/RubbleShape.cs" />
    <Compile Include="../Assets/Scripts/Rampage/LeapFrames.cs" />
    <None Include="golden/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../Assets/Plugins/x86_64/kaiju_core.dll" Condition="Exists('../Assets/Plugins/x86_64/kaiju_core.dll')" Link="kaiju_core.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
