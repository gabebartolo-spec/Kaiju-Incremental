{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/landmarks.json",
  "description": "Structure and types of this data file (CLAUDE.md hard rule 4); see data/schemas/README.md.",
  "type": "object",
  "properties": {
    "landmarks": {
      "type": "object",
      "properties": {
        "stadium": {
          "type": "object",
          "properties": {
            "chunks": {"type": "array", "items": {"$ref": "#/$defs/str"}},
            "d": {"$ref": "#/$defs/num"},
            "ground": {"type": "array", "items": {"$ref": "#/$defs/str"}},
            "h": {"$ref": "#/$defs/num"},
            "inside": {"$ref": "#/$defs/num"},
            "kvox": {"$ref": "#/$defs/str"},
            "w": {"$ref": "#/$defs/num"}
          },
          "required": ["chunks", "d", "ground", "h", "inside", "kvox", "w"],
          "patternProperties": {"^_": {"$ref": "#/$defs/str"}},
          "additionalProperties": false
        },
        "wheel": {
          "type": "object",
          "properties": {
            "chunks": {"type": "array", "items": {"$ref": "#/$defs/str"}},
            "d": {"$ref": "#/$defs/num"},
            "h": {"$ref": "#/$defs/num"},
            "inside": {"$ref": "#/$defs/num"},
            "kvox": {"$ref": "#/$defs/str"},
            "w": {"$ref": "#/$defs/num"}
          },
          "required": ["chunks", "d", "h", "inside", "kvox", "w"],
          "patternProperties": {"^_": {"$ref": "#/$defs/str"}},
          "additionalProperties": false
        }
      },
      "required": ["stadium", "wheel"],
      "patternProperties": {"^_": {"$ref": "#/$defs/str"}},
      "additionalProperties": false
    }
  },
  "required": ["landmarks"],
  "patternProperties": {"^_": {"$ref": "#/$defs/str"}},
  "additionalProperties": false,
  "$defs": {
    "bool": {"type": "boolean"},
    "int": {"type": "integer"},
    "num": {"type": "number"},
    "str": {"type": "string"},
    "hex6": {"type": "string", "pattern": "^[0-9a-fA-F]{6}$"}
  }
}
