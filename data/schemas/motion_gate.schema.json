{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "data/motion_gate.json",
  "description": "Structure and types of this data file (CLAUDE.md hard rule 4); see data/schemas/README.md.",
  "type": "object",
  "properties": {
    "slide_max": {"$ref": "#/$defs/num"},
    "aloft_yaw_max": {"$ref": "#/$defs/num"},
    "catch_straight": {"$ref": "#/$defs/num"},
    "catch_turn_smooth": {"$ref": "#/$defs/num"},
    "step_tol": {"$ref": "#/$defs/num"},
    "stretch_max": {"$ref": "#/$defs/num"},
    "pivot_max": {"$ref": "#/$defs/num"},
    "centre_max": {"$ref": "#/$defs/num"},
    "jerk_walk": {"$ref": "#/$defs/num"},
    "jerk_turn": {"$ref": "#/$defs/num"},
    "lift_min": {"$ref": "#/$defs/num"},
    "lift_max": {"$ref": "#/$defs/num"},
    "young": {
      "type": "object",
      "properties": {
        "catch_straight": {"$ref": "#/$defs/num"},
        "catch_turn_smooth": {"$ref": "#/$defs/num"},
        "jerk_walk": {"$ref": "#/$defs/num"},
        "jerk_turn": {"$ref": "#/$defs/num"}
      },
      "patternProperties": {"^_": {"$ref": "#/$defs/str"}},
      "additionalProperties": false
    }
  },
  "required": [
    "slide_max", "aloft_yaw_max", "catch_straight", "catch_turn_smooth", "step_tol", "stretch_max",
    "pivot_max", "centre_max", "jerk_walk", "jerk_turn", "lift_min", "lift_max"
  ],
  "patternProperties": {"^_": {"$ref": "#/$defs/str"}},
  "additionalProperties": false,
  "$defs": {
    "bool": {"type": "boolean"},
    "int": {"type": "integer"},
    "num": {"type": "number"},
    "str": {"type": "string"},
    "hex6": {"type": "string", "pattern": "^[0-9a-fA-F]{6}$"}
  }
}
