# Capture modes: the one place for the numbers (sourced by capture.yml and ci_capture.sh).
# fast = review captures on CI: real gl_compatibility, small frame, low fps, SSAO and glow off
#        (the city view reads --fast among the script args; the shipped game never does).
# full = the look as shipped: Forward+ on lavapipe when it works, 1280x720, 30 fps.
FAST_RENDERER=gl_compatibility
FAST_RES=960x540
FAST_FPS=20
FULL_RENDERER=auto
FULL_RES=1280x720
FULL_FPS=30
