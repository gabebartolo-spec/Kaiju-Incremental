extends SceneTree
## Dumps what the Unity slice runs on, through the game's own code: one real city block (grids,
## looks, palettes, window grids), the dusk look, the camera's tuning, the approved croc (skin,
## clips, rest pose and binds), and the digests tools/unity/check_core.py compares the C++ port
## against (tools/unity/slice_digests.gd).
##
##   godot --headless --path . --script tools/unity/export_slice.gd -- --croc=<dir>/reptilian_adult
##
## Output: unity/Assets/StreamingAssets/slice/ (gitignored, regenerated by this script).

const Digests := preload("res://tools/unity/slice_digests.gd")
const Kit := preload("res://tools/capture/capture_kit.gd")
const OUT_DIR := "res://unity/Assets/StreamingAssets/slice/"
const STAGE := 3
## Dusk is the game's one time of day (D-359); the block's lit windows are drawn from its look.
const TIME := "dusk"
const RADIUS := 62.0
const MAX_BUILDINGS := 36

var _croc := ""


func _initialize() -> void:
	if not NativeGuard.ok(self):
		return
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--croc="):
			_croc = arg.substr(7)
	_run.call_deferred()


func _run() -> void:
	await process_frame
	var species := Content.species_def("reptilian")
	var levels: Dictionary = Kit.STAGE_LEVELS[STAGE - 1]
	var stats := UpgradeTree.run_stats(
		Content.section("kaiju"), species, UpgradeTree.new(Content.upgrades(), levels)
	)
	var layout := CityGrowth.layout(Content.tuning(), STAGE, Seeds.make("city", 0))
	Content.set_time(TIME)
	var sim := RampageSim.new(stats, CityGrowth.for_stats(stats), layout, Seeds.make("army", 2))
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT_DIR))
	var picked := _pick_block(sim)
	var party := BuildingView.party_walls(sim.buildings)
	var meta: Array = []
	var bin := FileAccess.open(OUT_DIR + "buildings.bin", FileAccess.WRITE)
	bin.store_buffer("KSB1".to_ascii_buffer())
	bin.store_32(picked.size())
	var built: Array[Dictionary] = []
	for n: int in picked:
		var one := _building(sim.buildings[n], party[n])
		built.append(one)
		_store(bin, one)
		meta.append(one["meta"])
	bin.close()
	_write_json("slice.json", _slice_json(sim, meta))
	_write_json("digests.json", Digests.of(built))
	if _croc != "":
		_export_croc()
	print("exported %d buildings to %s" % [picked.size(), OUT_DIR])
	quit(0)


## The densest real block on the map: the plain ground buildings around the spot holding the most
## building volume within RADIUS.
func _pick_block(sim: RampageSim) -> Array[int]:
	var plain: Array[int] = []
	for n: int in sim.buildings.size():
		var b: RampageSim.Building = sim.buildings[n]
		var usual := b.landmark == "" and b.model == "" and b.hazard == "" and not b.is_span()
		if usual and is_zero_approx(float(b.base)):
			plain.append(n)
	var best := -1
	var best_load := -1.0
	for c: int in plain:
		var at: RampageSim.Building = sim.buildings[c]
		var load_here := 0.0
		for n: int in plain:
			var b: RampageSim.Building = sim.buildings[n]
			if Vector2(b.x - at.x, b.z - at.z).length() < RADIUS:
				load_here += float(b.w * b.d * b.height)
		if load_here > best_load:
			best_load = load_here
			best = c
	var centre: RampageSim.Building = sim.buildings[best]
	var near := plain.filter(
		func(n: int) -> bool:
			var b: RampageSim.Building = sim.buildings[n]
			return Vector2(b.x - centre.x, b.z - centre.z).length() < RADIUS
	)
	near.sort_custom(
		func(a: int, b: int) -> bool:
			var pa: RampageSim.Building = sim.buildings[a]
			var pb: RampageSim.Building = sim.buildings[b]
			var da := Vector2(pa.x - centre.x, pa.z - centre.z).length()
			var db := Vector2(pb.x - centre.x, pb.z - centre.z).length()
			return da < db or (da == db and a < b)
	)
	var out: Array[int] = []
	out.assign(near.slice(0, MAX_BUILDINGS))
	return out


func _building(b: RampageSim.Building, party: Dictionary) -> Dictionary:
	var voxels := BuildingVoxels.new(b, BuildingColors.base(b), party)
	var grid := BuildingCells.new(b, party)
	var mesher := CellMesher.new(voxels, grid)
	var frame := VoxelFrame.new(Vector3i(b.w, b.height, b.d), grid.res, Content.materials())
	var palette := PackedByteArray()
	palette.resize(256 * 4)
	for i: int in mini(mesher.palette.size(), 256):
		var c: Color = mesher.palette[i]
		palette[i * 4] = c.r8
		palette[i * 4 + 1] = c.g8
		palette[i * 4 + 2] = c.b8
		palette[i * 4 + 3] = c.a8
	var unit := WindowPalette.unit_of(b)
	var align := WindowPalette.align_of(b, unit)
	return {
		"mesher": mesher,
		"grid": grid,
		"frame": frame,
		"drawn": mesher.drawn(grid.cells),
		"palette": palette,
		"unit": unit,
		"align": align,
		"meta":
		{
			"x": b.x,
			"z": b.z,
			"w": b.w,
			"d": b.d,
			"height": b.height,
			"style": b.style,
			"tier": b.tier,
		},
	}


func _store(f: FileAccess, one: Dictionary) -> void:
	var mesher: CellMesher = one["mesher"]
	var frame: VoxelFrame = one["frame"]
	var grid: BuildingCells = one["grid"]
	var unit: Vector2 = one["unit"]
	var align: Vector2 = one["align"]
	for v: int in [mesher.dims.x, mesher.dims.y, mesher.dims.z]:
		f.store_32(v)
	for v: int in [mesher.offset.x, mesher.offset.y, mesher.offset.z]:
		f.store_32(v)
	for v: float in [mesher.origin.x, mesher.origin.y, mesher.origin.z, mesher.voxel]:
		f.store_float(v)
	f.store_32(mesher.salt)
	for v: float in [mesher.noise, unit.x, unit.y, align.x, align.y]:
		f.store_float(v)
	f.store_32(1 if frame.has_fixtures else 0)
	f.store_32(grid.res)
	f.store_buffer(grid.cells)
	var drawn: PackedByteArray = one["drawn"]
	f.store_buffer(drawn)
	f.store_buffer(mesher.looks)
	var palette: PackedByteArray = one["palette"]
	f.store_buffer(palette)
	f.store_buffer(mesher.finish)
	f.store_buffer(frame.fixtures)


func _slice_json(sim: RampageSim, meta: Array) -> Dictionary:
	var windows := []
	var cols := WindowPalette.colours()
	var ends := WindowPalette.weight_ends()
	for i: int in cols.size():
		windows.append({"color": [cols[i].x, cols[i].y, cols[i].z], "end": ends[i]})
	var gain := WindowPalette.gain()
	return {
		"look": Content.look(),
		"camera": Content.section("camera"),
		"destruction": Content.section("destruction"),
		"time": TIME,
		"body_scale": sim.body_scale(),
		"model_height": KaijuModel.MODEL_HEIGHT,
		"window_palette": windows,
		"window_gain": [gain.x, gain.y],
		"window_palette_on": WindowPalette.on(),
		"buildings": meta,
	}


## The croc as the game loads it: the rig's rest pose and binds (after its arms relax, as VoxelSkin
## binds them), the clips' fit, and the skin and clip files.
func _export_croc() -> void:
	var rig := KaijuRig.load_from(_croc, KaijuModel.MODEL_HEIGHT, 0.0)
	var clips := KaijuClips.read(_croc + ".kclip")
	var fit_error := clips.fit(rig)
	if fit_error != "":
		push_error("clips do not fit the rig: " + fit_error)
	var bones := []
	for bone_name: String in rig.bone_names():
		var bind := _to_rig(rig, rig.bone(bone_name)).affine_inverse()
		var rest := rig.rest_of(bone_name)
		bones.append(
			{"name": bone_name, "parent": rig.parent_of(bone_name), "rest": _xf(rest), "bind": _xf(bind)}
		)
	_write_json(
		"rig.json",
		{"bones": bones, "rig_scale": clips.rig_scale, "rig_origin": _v3(clips.rig_origin)}
	)
	var raw := FileAccess.get_file_as_bytes(_croc + ".vskin")
	var plain := raw.decompress_dynamic(-1, FileAccess.COMPRESSION_GZIP)
	_write_bytes("croc.vskin", plain)
	_write_bytes("croc.kclip", FileAccess.get_file_as_bytes(_croc + ".kclip"))
	rig.free()


func _to_rig(rig: Node3D, node: Node3D) -> Transform3D:
	var t := node.transform
	var parent := node.get_parent()
	while parent != rig and parent is Node3D:
		t = (parent as Node3D).transform * t
		parent = parent.get_parent()
	return t


func _xf(t: Transform3D) -> Array:
	return [
		t.basis.x.x, t.basis.x.y, t.basis.x.z,
		t.basis.y.x, t.basis.y.y, t.basis.y.z,
		t.basis.z.x, t.basis.z.y, t.basis.z.z,
		t.origin.x, t.origin.y, t.origin.z,
	]


func _v3(v: Vector3) -> Array:
	return [v.x, v.y, v.z]


func _write_json(file: String, data: Dictionary) -> void:
	var f := FileAccess.open(OUT_DIR + file, FileAccess.WRITE)
	f.store_string(JSON.stringify(data, " "))
	f.close()


func _write_bytes(file: String, data: PackedByteArray) -> void:
	var f := FileAccess.open(OUT_DIR + file, FileAccess.WRITE)
	f.store_buffer(data)
	f.close()
