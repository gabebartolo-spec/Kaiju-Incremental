<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Unity slice's bake without Godot (tools/unity/export_slice.gd's output, byte for byte):
       the generated C# sim plus kaiju_core.dll. Run: bash tools/unity/bake_slice.sh -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UnityProject>$(MSBuildThisFileDirectory)../../../unity</UnityProject>
    <OutputPath>$(UnityProject)/Obj/slicebake/bin/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="$(UnityProject)/Assets/Scripts/Sim/**/*.cs" />
    <Compile Include="$(UnityProject)/Assets/Scripts/Native.cs" />
    <None Include="$(UnityProject)/Assets/Plugins/x86_64/kaiju_core.dll" Condition="Exists('$(UnityProject)/Assets/Plugins/x86_64/kaiju_core.dll')" Link="kaiju_core.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
