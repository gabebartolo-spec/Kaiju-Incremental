; Engine configuration file.
config_version=5

[application]

config/name="Kaiju Evolution"
config/version="0.1-demo"
run/main_scene="res://scenes/main.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.02, 0.03, 0.08, 1)
; The save folder keeps its old name (the game was "Kaiju Incremental"), so no save is lost.
config/use_custom_user_dir=true
config/custom_user_dir_name="Godot/app_userdata/Kaiju Incremental"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Rng="*res://autoload/rng.gd"
GameData="*res://autoload/game_data.gd"
EventBus="*res://autoload/event_bus.gd"
SaveSystem="*res://autoload/save_system.gd"
Settings="*res://autoload/settings.gd"
Debug="*res://autoload/debug.gd"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_call_argument=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=2

[shader_globals]

bubble_radius={
"type": "float",
"value": 0.0
}
smoke_focus={
"type": "float",
"value": 0.0
}
smoke_soft_m={
"type": "float",
"value": 0.0
}

[gui]

theme/custom_font="res://assets/fonts/kaiju_block.ttf"

theme/default_font_size=24

[rendering]

anti_aliasing/quality/msaa_3d=2

[physics]

3d/physics_engine="Jolt Physics"
